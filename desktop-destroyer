#!/usr/bin/env bash
# Launcher: prefers a local virtualenv, falls back to the system PySide6.
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

if [[ -x "$here/.venv/bin/python" ]]; then
    exec "$here/.venv/bin/python" -m desktop_destroyer "$@"
fi

if ! python3 -c "import PySide6.QtWidgets" 2>/dev/null; then
    cat >&2 <<'MSG'
desktop-destroyer: PySide6 is missing.

  Fedora / RHEL              sudo dnf install python3-pyside6
  Debian 13+, Ubuntu 26.04+  sudo apt install python3-pyside6.qtwidgets python3-pyside6.qtmultimedia python3-pyside6.qtdbus
  Arch                       sudo pacman -S pyside6
  anywhere                   ./install.sh        (sets up a local .venv;
                             Ubuntu 24.04 and older have no package)
MSG
    exit 1
fi

cd "$here"
exec python3 -m desktop_destroyer "$@"
